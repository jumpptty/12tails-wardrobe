# The page keeps LF endings on every PC: wardrobe_publish.py copies its bytes, so a CRLF checkout would change the
# published index.html (seen at the 2026-11-09 split: a fresh clone checked it out CRLF).
wardrobe/index.html text eol=lf
# The data keeps its exact bytes on every PC (tracked since 2026-11-10): no CRLF conversion of its JSON, so the published
# data-<hash> folder and the video repo's readers see the same files at home and at the office
wardrobe/data/** -text
